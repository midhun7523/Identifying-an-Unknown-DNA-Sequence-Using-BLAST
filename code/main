Prompt 16 – Experiment 2: Query Length Effect
Prompt:
Run Experiment 2 testing query lengths from 15 bp to 200 bp against E-value significance.

Code 3 – Query length vs E-value

python
from Bio import Align
import math

db_seq = "A" * 1000  # subject sequence
db = {"Reference": db_seq}

aligner = Align.PairwiseAligner()
aligner.mode = "local"
aligner.match_score = 1
aligner.mismatch_score = -2
aligner.open_gap_score = -5
aligner.extend_gap_score = -2

K = 0.1
lam = 0.26
n = len(db_seq)

print(f"{'Query_len':>10} {'Score':>8} {'E-value':>12} {'Significant?':>14}")

for L in [15, 20, 25, 30, 35, 40, 50, 70, 100, 150, 200]:
    query = "A" * L
    m = L

    alignments = list(aligner.align(query, db_seq))
    aln = alignments[0]
    score = aln.score

    e_value = K * m * n * math.exp(-lam * score)
    sig = "Yes" if e_value < 1e-3 else "No"

    print(f"{L:10d} {score:8.1f} {e_value:12.2e} {sig:>14}")

