Prompt 17 – Experiment 3: Database Scale
Prompt:
Run Experiment 3 testing database sizes from 100 bp to 100,000,000 bp as a database-scale demonstration.

Code 4 – Database size vs E-value
python
import math

query_len = 70
query = "A" * query_len

aligner = Align.PairwiseAligner()
aligner.mode = "local"
aligner.match_score = 1
aligner.mismatch_score = -2
aligner.open_gap_score = -5
aligner.extend_gap_score = -2

K = 0.1
lam = 0.26
m = query_len
score = query_len  # perfect 70-base match

print(f"{'DB_size_bp':>12} {'Score':>8} {'E-value':>12}")

# Scale the database length mathematically instead of creating a 100-million-base string.
for n in [100, 1_000, 10_000, 100_000, 1_000_000, 10_000_000, 100_000_000]:
    e_value = K * m * n * math.exp(-lam * score)
    print(f"{n:12d} {score:8.1f} {e_value:12.2e}")


