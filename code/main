Prompt 15 – Experiment 1: Mutation Sensitivity
Prompt:
Run Experiment 1 testing 0 to 20 base mismatches on a 70 bp query sequence.

Code 2 – Mutation sensitivity experiment

python
from Bio import Align
import math

query_len = 70
base_query = "A" * query_len  # simple homogeneous query

db = {
    "Perfect_match": "A" * query_len,
}

aligner = Align.PairwiseAligner()
aligner.mode = "local"
aligner.match_score = 1
aligner.mismatch_score = -2
aligner.open_gap_score = -5
aligner.extend_gap_score = -2

K = 0.1
lam = 0.26
m = query_len
n = sum(len(seq) for seq in db.values())

print(f"{'Mismatches':>12} {'%ID':>8} {'Score':>8} {'E-value':>12}")

for mm in range(0, 21):
    # Create mutated query: first (query_len - mm) A's, then mm T's
    mutated_query = "A" * (query_len - mm) + "T" * mm

    subject = db["Perfect_match"]
    alignments = list(aligner.align(mutated_query, subject))
    aln = alignments[0]
    score = aln.score

    q_aln, s_aln = aln[0], aln[1]
    matches = sum(q == s for q, s in zip(q_aln, s_aln) if q != "-" and s != "-")
    aln_len = sum(q != "-" and s != "-" for q, s in zip(q_aln, s_aln))
    percent_id = (matches / aln_len * 100) if aln_len else 0

    e_value = K * m * n * math.exp(-lam * score)

    print(f"{mm:12d} {percent_id:8.1f} {score:8.1f} {e_value:12.2e}")

